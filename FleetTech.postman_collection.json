{
	"info": {
		"_postman_id": "f1e37-tech-api-collection-v1",
		"name": "FleetTech Enterprise API",
		"description": "Colección completa de endpoints para FleetTech Enterprise API (Laravel Sanctum). Incluye autenticación automática, CRUDs de Operadores, Vehículos, Inspecciones, Defectos y Dashboard.",
